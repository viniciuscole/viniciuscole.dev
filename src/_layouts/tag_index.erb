---
layout: default
---
<%# Indice de todas as tags em uso no idioma da pagina. `data.tags` ja vem
    ordenado do builder. %>
<h1><%= t("tags.index_title") %></h1>
<p class="page-intro"><%= t("tags.index_intro") %></p>

<% if data.tags.empty? %>
  <p class="empty-state"><%= t("tags.empty") %></p>
<% else %>
  <ul class="tag-index">
    <% data.tags.each do |tag| %>
      <li>
        <a href="<%= relative_url("#{locale_prefix(resource.data.locale)}tags/#{tag}/") %>">
          <%= tag_label(tag) %>
        </a>
      </li>
    <% end %>
  </ul>
<% end %>
