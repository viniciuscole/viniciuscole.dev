---
layout: default
---
<article class="post">
  <header>
    <h1><%= data.title %></h1>
    <time datetime="<%= data.date.strftime("%Y-%m-%d") %>">
      <%= data.date.strftime("%Y-%m-%d") %>
    </time>
  </header>

  <div class="post-body">
    <%= yield %>
  </div>

  <%= render "tag_list", post: resource %>
</article>
