<%# Ordenacao: `order` primeiro, titulo como desempate. Sem o desempate,
    projetos com o mesmo `order` caem na ordem do sistema de arquivos e a
    listagem pode sair diferente de uma maquina para outra. %>
<div class="project-grid">
  <% collections.projects.resources
       .select { |p| p.data.locale.to_s == resource.data.locale.to_s && (!featured_only || p.data.featured) }
       .sort_by { |p| [p.data.order || 999, p.data.title.to_s] }
       .each do |project| %>
    <%= render "project_card", project: project %>
  <% end %>
</div>
